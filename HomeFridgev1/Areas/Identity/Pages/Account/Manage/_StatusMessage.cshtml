@model string

@if (!string.IsNullOrEmpty(Model))
{
    var statusMessageClass = Model.StartsWith("Error") ? "bg-red-50 text-red-700 border-red-200" : "bg-emerald-50 text-emerald-700 border-emerald-200";
    <div class="@statusMessageClass border rounded-2xl px-4 py-3 mb-4 text-sm font-medium" role="alert">
        @Model
    </div>
}
