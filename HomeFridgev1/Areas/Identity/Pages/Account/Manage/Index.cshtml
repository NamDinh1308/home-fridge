@page
@model IndexModel
@{
    ViewData["Title"] = "Hồ sơ";
    ViewData["ActivePage"] = ManageNavPages.Index;
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="max-w-2xl mx-auto px-4">
    <div class="mb-6">
        <h2 class="text-2xl font-bold text-slate-800">Hồ sơ</h2>
        <p class="mt-2 text-slate-600 text-sm">
            Cập nhật thông tin tài khoản cơ bản của bạn.
        </p>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="profile-form" method="post" class="space-y-5">
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-2">Tên đăng nhập</label>
            <input asp-for="Username"
                   class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-600"
                   disabled />
        </div>

        <div>
            <label asp-for="Input.PhoneNumber" class="block text-sm font-medium text-slate-700 mb-2">Số điện thoại</label>
            <input asp-for="Input.PhoneNumber"
                   class="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#00ff95]" />
            <span asp-validation-for="Input.PhoneNumber" class="mt-1 block text-sm text-red-600"></span>
        </div>

        <div class="pt-2">
            <button id="update-profile-button"
                    type="submit"
                    class="inline-flex items-center justify-center rounded-2xl bg-[#00ff95] px-5 py-3 font-semibold text-slate-900 hover:bg-[#00e686] transition">
                Lưu thay đổi
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}