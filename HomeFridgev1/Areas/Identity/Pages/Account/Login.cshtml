@page
@model LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Home's Fridge</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 min-h-screen flex items-center justify-center p-4 sm:p-8">

<div class="max-w-5xl w-full bg-white rounded-[2rem] shadow-2xl overflow-hidden flex flex-col lg:flex-row">
    
    <!-- Left Panel (Image Background) -->
    <div class="lg:w-1/2 relative min-h-[400px] lg:min-h-[600px] flex flex-col justify-between p-10">
        <!-- Background Image -->
        <img src="https://images.unsplash.com/photo-1542838132-92c53300491e?q=80&w=1974&auto=format&fit=crop" alt="Fresh Vegetables" class="absolute inset-0 w-full h-full object-cover" />
        
        <!-- Gradient Overlay for text readability -->
        <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-transparent to-black/80"></div>
        
        <!-- Top Left Logo -->
        <div class="relative z-10 flex items-center gap-2">
            <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-[#00ff95]">
                <svg class="w-6 h-6 text-[#0f172a]" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
            </div>
            <span class="text-white font-bold tracking-wider text-lg">HOME'S FRIDGE</span>
        </div>

        <!-- Bottom Text -->
        <div class="relative z-10 mt-auto pt-20">
            <h1 class="text-4xl font-bold text-white mb-4">
                Elevated Freshness
            </h1>
            <p class="text-slate-200">
                Lưu trữ thực phẩm an toàn, kiểm soát hạn sử dụng và mang đến cho gia đình bạn những bữa ăn tươi ngon nhất. Giải pháp thông minh cho căn bếp hiện đại.
            </p>
        </div>
    </div>

    <!-- Right Form Area -->
    <div class="lg:w-1/2 flex flex-col justify-center p-8 sm:p-12 lg:p-16">
        <div class="max-w-md w-full mx-auto">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-900 tracking-tight">Chào mừng trở lại</h2>
                <p class="mt-2 text-sm text-slate-500">Vui lòng nhập thông tin để quản lý tủ lạnh của bạn.</p>
            </div>

            <form id="account" method="post" class="space-y-5">
                <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm mb-4 bg-red-50 p-3 rounded-xl border border-red-100"></div>

                <div>
                    <label asp-for="Input.Email" class="block text-sm font-semibold text-slate-700 mb-1.5 ml-1">Email Address</label>
                    <input asp-for="Input.Email" class="appearance-none block w-full px-4 py-3.5 bg-slate-50 border border-slate-200 rounded-2xl placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#00ff95] focus:bg-white sm:text-sm transition-all" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-red-500 text-xs mt-1 block ml-1"></span>
                </div>

                <div>
                    <label asp-for="Input.Password" class="block text-sm font-semibold text-slate-700 mb-1.5 ml-1">Password</label>
                    <input asp-for="Input.Password" class="appearance-none block w-full px-4 py-3.5 bg-slate-50 border border-slate-200 rounded-2xl placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#00ff95] focus:bg-white sm:text-sm transition-all" placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="text-red-500 text-xs mt-1 block ml-1"></span>
                </div>

                <div class="flex items-center justify-between pt-1 pb-3">
                    <div class="flex items-center">
                        <input asp-for="Input.RememberMe" class="h-4 w-4 rounded border-slate-300 text-[#00d67d] focus:ring-[#00ff95] cursor-pointer" />
                        <label asp-for="Input.RememberMe" class="ml-2 block text-sm text-slate-600 font-medium cursor-pointer">
                            Ghi nhớ đăng nhập
                        </label>
                    </div>

                    <div class="text-sm">
                        <a id="forgot-password" asp-page="./ForgotPassword" class="font-bold text-[#00d67d] hover:text-[#00ff95] transition-colors">
                            Quên mật khẩu?
                        </a>
                    </div>
                </div>

                <div>
                    <button id="login-submit" type="submit" class="w-full flex justify-center py-4 px-4 border border-transparent rounded-[1.25rem] shadow-sm font-bold text-white bg-[#00A86B] hover:bg-[#008f5a] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#00A86B] transition-all transform active:scale-[0.98]">
                        Đăng nhập
                    </button>
                </div>
            </form>

            <div class="mt-8 text-center text-sm font-medium text-slate-600 border-t border-slate-100 pt-6">
                Chưa có tài khoản? 
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="font-bold text-[#00A86B] hover:text-[#008f5a] transition-colors">
                    Đăng ký tài khoản mới
                </a>
            </div>
            
            <div class="mt-3 text-center">
                 <a href="/" class="text-xs font-semibold text-slate-400 hover:text-slate-600 uppercase tracking-widest">Trở về trang chủ</a>
            </div>
        </div>
    </div>
</div>

</body>
</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
