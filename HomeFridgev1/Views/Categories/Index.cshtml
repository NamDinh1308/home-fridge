@model IEnumerable<HomeFridgev1.Models.Entities.Category>

@{
    ViewData["Title"] = "Danh mục thực phẩm";
}

<div class="max-w-6xl mx-auto px-4 md:px-8 py-6 md:py-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
        <div>
            <h1 class="text-2xl font-bold text-slate-800 font-headline">Danh mục thực phẩm</h1>
            <p class="mt-2 text-slate-600 text-sm">Quản lý các loại phân loại thực phẩm trong gia đình của bạn.</p>
        </div>

        <a asp-action="Create"
           class="w-full sm:w-auto inline-flex items-center justify-center rounded-[1.25rem] bg-primary hover:bg-emerald-600 text-white px-6 py-2.5 font-bold transition-all shadow-[0_10px_20px_-10px_rgba(16,185,129,0.5)] hover:-translate-y-0.5">
            <span class="material-symbols-outlined mr-2 text-xl">add</span>
            Thêm danh mục
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 rounded-[1.25rem] border border-green-200 bg-green-50 px-5 py-4 text-green-700 text-sm font-medium shadow-sm">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 rounded-[1.25rem] border border-red-200 bg-red-50 px-5 py-4 text-red-700 text-sm font-medium shadow-sm">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="bg-white rounded-[2rem] border border-slate-100 shadow-sm overflow-hidden">
        @if (!Model.Any())
        {
            <div class="p-12 text-center">
                <div class="w-16 h-16 mx-auto bg-slate-50 rounded-full flex items-center justify-center mb-4 text-slate-400">
                    <span class="material-symbols-outlined text-3xl">category</span>
                </div>
                <h2 class="text-lg font-semibold text-slate-700 font-headline">Chưa có danh mục nào</h2>
                <p class="mt-2 text-slate-500 text-sm">Hãy thêm danh mục đầu tiên để bắt đầu sắp xếp thực phẩm tốt hơn.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-100 bg-slate-50/75 text-xs font-bold uppercase tracking-wider text-slate-500">
                            <th class="px-6 py-4">Tên danh mục</th>
                            <th class="px-6 py-4">Mô tả</th>
                            <th class="px-6 py-4 text-center">Thứ tự</th>
                            <th class="px-6 py-4">Loại</th>
                            <th class="px-6 py-4">Trạng thái</th>
                            <th class="px-6 py-4 text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm text-slate-700">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-6 py-4 font-bold text-slate-800">
                                    @item.Name
                                </td>
                                <td class="px-6 py-4 text-slate-500 max-w-xs truncate">
                                    @(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)
                                </td>
                                <td class="px-6 py-4 text-center font-semibold">
                                    @item.SortOrder
                                </td>
                                <td class="px-6 py-4">
                                    @if (item.IsDefault)
                                    {
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                            Mặc định
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">
                                            Tự tạo
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4">
                                    @if (item.IsActive)
                                    {
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-green-50 text-green-700 border border-green-200">
                                            Đang hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-red-50 text-red-700 border border-red-200">
                                            Ngừng hoạt động
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="inline-flex items-center gap-3">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="inline-flex items-center justify-center rounded-[1.25rem] border border-slate-200 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50 transition-all">
                                            <span class="material-symbols-outlined text-[16px] mr-1">edit</span>
                                            Sửa
                                        </a>

                                        <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            @if (item.IsActive)
                                            {
                                                <button type="submit"
                                                        class="inline-flex items-center justify-center rounded-[1.25rem] border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-bold text-red-700 hover:bg-red-100 transition-all">
                                                    <span class="material-symbols-outlined text-[16px] mr-1">block</span>
                                                    Tắt
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="inline-flex items-center justify-center rounded-[1.25rem] border border-green-200 bg-green-50 px-3 py-1.5 text-xs font-bold text-green-700 hover:bg-green-100 transition-all">
                                                    <span class="material-symbols-outlined text-[16px] mr-1">check_circle</span>
                                                    Bật
                                                </button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
