<script>
    (function () {
        const bellButton = document.getElementById('notification-bell-button');
        const bellPanel = document.getElementById('notification-bell-panel');
        
        if (bellButton && bellPanel) {
            bellButton.addEventListener('click', function (e) {
                e.stopPropagation();
                
                // Close any open profile dropdowns
                document.querySelectorAll('.account-menu-panel').forEach(panel => {
                    panel.classList.add('hidden');
                });
                
                bellPanel.classList.toggle('hidden');
            });
            
            bellPanel.addEventListener('click', function (e) {
                e.stopPropagation();
            });
            
            document.addEventListener('click', function () {
                bellPanel.classList.add('hidden');
            });
        }
    })();
</script>
