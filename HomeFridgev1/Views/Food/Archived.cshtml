@model IEnumerable<HomeFridgev1.Models.Entities.FoodItem>

@{
    ViewData["Title"] = "Kho lưu trữ";
    var groupedItems = Model
        .GroupBy(x => x.ArchiveGroup?.Name ?? "Chưa phân vùng")
        .OrderBy(g => g.Key)
        .ToList();
}

<div class="max-w-5xl mx-auto px-8 py-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
        <div>
            <h1 class="text-2xl font-bold text-slate-800 font-headline">Kho lưu trữ thực phẩm</h1>
            <p class="mt-2 text-slate-600 text-sm">
                Các món được chia theo <strong>vùng lưu trữ</strong> để bạn dễ quan sát, giống như sắp xếp tệp vào các thư mục khác nhau.
            </p>
        </div>

        <a asp-action="Index"
           class="inline-flex items-center justify-center rounded-[1.25rem] border border-slate-200 bg-white px-6 py-2.5 font-bold text-slate-700 hover:bg-slate-50 transition-all shadow-sm">
            <span class="material-symbols-outlined mr-2 text-xl">arrow_back</span>
            Về danh sách thực phẩm
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 rounded-[1.25rem] border border-green-200 bg-green-50 px-5 py-4 text-green-700 text-sm font-medium shadow-sm">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 rounded-[1.25rem] border border-red-200 bg-red-50 px-5 py-4 text-red-700 text-sm font-medium shadow-sm">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="mb-6 rounded-[1.5rem] border border-cyan-200 bg-cyan-50 px-5 py-4 text-sm text-cyan-800 shadow-sm">
        Gợi ý: với các món đang được cất riêng, bạn có thể thao tác trực tiếp ngay trong vùng lưu trữ mà không cần khôi phục trước.
    </div>

    @if (!Model.Any())
    {
        <div class="bg-surface-container-lowest rounded-[2rem] border border-slate-100 shadow-sm p-12 text-center">
            <div class="w-16 h-16 mx-auto bg-surface-container-low rounded-full flex items-center justify-center mb-4">
                <span class="material-symbols-outlined text-3xl text-slate-400">inventory_2</span>
            </div>
            <h2 class="text-lg font-semibold text-slate-700 font-headline">Kho lưu trữ đang trống</h2>
            <p class="mt-2 text-slate-500 text-sm">Chưa có thực phẩm nào được lưu trữ.</p>

            <a asp-action="Index"
               class="mt-6 inline-flex items-center justify-center rounded-[1.25rem] bg-primary hover:bg-emerald-600 text-white px-6 py-2.5 font-bold transition-all shadow-[0_10px_20px_-10px_rgba(16,185,129,0.5)] hover:-translate-y-0.5">
                Quay lại danh sách chính
            </a>
        </div>
    }
    else
    {
        <div class="space-y-8">
            @foreach (var group in groupedItems)
            {
                <section class="bg-surface-container-lowest rounded-[2rem] border border-slate-100 shadow-sm overflow-hidden transition-all hover:shadow-md">
                    <div class="px-6 py-5 border-b border-slate-100 bg-slate-50/60 flex items-center justify-between gap-4">
                        <div>
                            <h2 class="text-lg font-bold text-slate-800 font-headline">@group.Key</h2>
                            <p class="mt-1 text-sm text-slate-500">@group.Count() thực phẩm trong vùng lưu trữ này</p>
                        </div>

                        <div class="inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-bold text-slate-600">
                            <span class="material-symbols-outlined text-[16px] mr-1">folder</span>
                            Vùng lưu trữ
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="min-w-full">
                            <thead class="bg-slate-50/40">
                                <tr class="text-left text-xs font-bold text-slate-500 uppercase tracking-wider">
                                    <th class="px-6 py-4">Thực phẩm</th>
                                    <th class="px-6 py-4">Danh mục</th>
                                    <th class="px-6 py-4">Vị trí</th>
                                    <th class="px-6 py-4">Số lượng</th>
                                    <th class="px-6 py-4">Trạng thái</th>
                                    <th class="px-6 py-4">Ngày lưu trữ</th>
                                    <th class="px-6 py-4 text-right">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var item in group)
                                {
                                    var statusClass = item.CurrentStatus.ToString() switch
                                    {
                                        "Normal" => "bg-emerald-50 text-emerald-700 border border-emerald-200",
                                        "Warning" => "bg-amber-50 text-amber-700 border border-amber-200",
                                        "Urgent" => "bg-orange-50 text-orange-700 border border-orange-200",
                                        "Expired" => "bg-red-50 text-red-700 border border-red-200",
                                        "OutOfStock" => "bg-slate-100 text-slate-700 border border-slate-200",
                                        _ => "bg-slate-100 text-slate-700 border border-slate-200"
                                    };

                                    <tr class="text-sm text-slate-700 hover:bg-slate-50/50 transition-colors">
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-3">
                                                @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                                                {
                                                    <div class="h-14 w-14 rounded-2xl overflow-hidden border border-slate-200 bg-slate-50 shrink-0">
                                                        <img src="@item.ImagePath" alt="@item.Name" class="h-full w-full object-cover" />
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="h-14 w-14 rounded-2xl border border-dashed border-slate-300 bg-slate-50 flex items-center justify-center text-slate-400 shrink-0">
                                                        <span class="material-symbols-outlined text-[20px]">image</span>
                                                    </div>
                                                }

                                                <div>
                                                    <div class="font-bold text-slate-800">@item.Name</div>
                                                    @if (string.IsNullOrWhiteSpace(item.ImagePath))
                                                    {
                                                        <div class="text-xs text-slate-400 mt-0.5">Chưa có ảnh</div>
                                                    }
                                                </div>
                                            </div>
                                        </td>

                                        <td class="px-6 py-4">@item.Category?.Name</td>
                                        <td class="px-6 py-4 text-slate-500">@item.StorageLocation?.Name</td>
                                        <td class="px-6 py-4 font-semibold">
                                            @item.CurrentQuantity.ToString("0.##")
                                            <span class="text-slate-400 text-xs ml-1">@item.Unit</span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="inline-flex items-center rounded-full px-3 py-1 text-[11px] font-bold uppercase tracking-wider @statusClass">
                                                @item.CurrentStatus
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            @item.LastStatusChangedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="flex flex-wrap justify-end gap-2">
                                                <a asp-action="Consume"
                                                   asp-route-id="@item.Id"
                                                   asp-route-source="archived"
                                                   class="inline-flex items-center justify-center rounded-xl border border-amber-200 bg-amber-50 px-3 py-1.5 text-xs font-bold text-amber-700 hover:bg-amber-100 transition-all">
                                                    <span class="material-symbols-outlined text-[16px] mr-1">restaurant</span>
                                                    Dùng bớt
                                                </a>

                                                <a asp-action="Restock"
                                                   asp-route-id="@item.Id"
                                                   asp-route-source="archived"
                                                   class="inline-flex items-center justify-center rounded-xl border border-cyan-200 bg-cyan-50 px-3 py-1.5 text-xs font-bold text-cyan-700 hover:bg-cyan-100 transition-all">
                                                    <span class="material-symbols-outlined text-[16px] mr-1">add_shopping_cart</span>
                                                    Bổ sung
                                                </a>

                                                <form asp-action="Restore" method="post" class="inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit"
                                                            class="inline-flex items-center justify-center rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-700 hover:bg-emerald-100 transition-all">
                                                        <span class="material-symbols-outlined text-[16px] mr-1">restore</span>
                                                        Khôi phục
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        </div>
    }
</div>
