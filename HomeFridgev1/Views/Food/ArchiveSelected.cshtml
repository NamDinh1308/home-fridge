@model HomeFridgev1.Models.ViewModels.FoodBulkArchiveViewModel

@{
    ViewData["Title"] = "Lưu trữ thực phẩm đã chọn";
}

<div class="max-w-5xl mx-auto px-8 py-8">
    <div class="mb-8">
        <h1 class="text-2xl font-bold text-slate-800 font-headline">Lưu trữ thực phẩm đã chọn</h1>
        <p class="mt-2 text-slate-600 text-sm">
            Bạn đang chuẩn bị chuyển <strong>@Model.Items.Count</strong> món vào kho lưu trữ. Mỗi lần lưu trữ sẽ gắn các món vào một <strong>vùng lưu trữ</strong>, giống như đưa tệp vào thư mục riêng.
        </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
        <div class="lg:col-span-3">
            <div class="bg-white rounded-[2rem] border border-slate-100 shadow-sm overflow-hidden">
                <div class="px-6 py-5 border-b border-slate-100 bg-slate-50/60">
                    <h2 class="text-lg font-bold text-slate-800">Các thực phẩm được chọn</h2>
                </div>

                <div class="divide-y divide-slate-100">
                    @foreach (var item in Model.Items)
                    {
                        <div class="px-6 py-4 flex items-center justify-between gap-4">
                            <div class="flex items-center gap-4 min-w-0">
                                @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                                {
                                    <div class="w-14 h-14 rounded-2xl overflow-hidden border border-slate-200 bg-slate-50 shrink-0">
                                        <img src="@item.ImagePath" alt="@item.Name" class="w-full h-full object-cover" />
                                    </div>
                                }
                                else
                                {
                                    <div class="w-14 h-14 rounded-2xl border border-dashed border-slate-300 bg-slate-50 flex items-center justify-center text-slate-400 shrink-0">
                                        <span class="material-symbols-outlined text-[20px]">image</span>
                                    </div>
                                }

                                <div class="min-w-0">
                                    <div class="font-bold text-slate-800 truncate">@item.Name</div>
                                    <div class="text-sm text-slate-500">
                                        @(item.CategoryName ?? "Không có danh mục")
                                        <span class="mx-2 text-slate-300">•</span>
                                        @(item.StorageLocationName ?? "Không có vị trí")
                                    </div>
                                </div>
                            </div>

                            <div class="text-right shrink-0">
                                <div class="font-semibold text-slate-800">@item.CurrentQuantity.ToString("0.##") @item.Unit</div>
                                <div class="text-xs text-slate-400">@item.CurrentStatus</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="lg:col-span-2">
            <form asp-action="ArchiveSelected" method="post" class="bg-white rounded-[2rem] border border-slate-100 shadow-sm p-6 space-y-5">
                @Html.AntiForgeryToken()

                @for (int i = 0; i < Model.SelectedIds.Count; i++)
                {
                    <input asp-for="SelectedIds[i]" type="hidden" />
                }

                <div>
                    <h2 class="text-lg font-bold text-slate-800">Xác nhận lưu trữ</h2>
                    <p class="mt-2 text-sm text-slate-500">
                        Chọn một vùng lưu trữ có sẵn hoặc tạo vùng mới ngay trong form.
                    </p>
                </div>

                <div>
                    <label asp-for="ArchiveGroupId" class="block text-sm font-medium text-slate-700 mb-2">
                        Vùng lưu trữ có sẵn
                    </label>
                    <select asp-for="ArchiveGroupId"
                            asp-items="Model.AvailableArchiveGroups"
                            id="ArchiveGroupId"
                            class="w-full rounded-2xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#00ff95] disabled:bg-slate-100 disabled:text-slate-400">
                    </select>
                    <span asp-validation-for="ArchiveGroupId" class="text-red-600 text-sm"></span>
                </div>

                <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4">
                    <label class="inline-flex items-center gap-3 cursor-pointer select-none">
                        <input asp-for="CreateNewArchiveGroup"
                               id="CreateNewArchiveGroup"
                               type="checkbox"
                               class="h-4 w-4 rounded border-slate-300 text-emerald-500 focus:ring-emerald-400" />
                        <span class="text-sm font-medium text-slate-700">Tạo vùng lưu trữ mới ngay trong form</span>
                    </label>

                    <div id="NewArchiveGroupNameWrapper" class="mt-4 hidden">
                        <label asp-for="NewArchiveGroupName" class="block text-sm font-medium text-slate-700 mb-2">
                            Tên vùng lưu trữ mới
                        </label>
                        <input asp-for="NewArchiveGroupName"
                               id="NewArchiveGroupName"
                               class="w-full rounded-2xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#00ff95]"
                               placeholder="Ví dụ: Cuối tuần, Để dành, Dịp đặc biệt..." />
                        <span asp-validation-for="NewArchiveGroupName" class="text-red-600 text-sm"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="Reason" class="block text-sm font-medium text-slate-700 mb-2">
                        Ghi chú chung
                    </label>
                    <textarea asp-for="Reason"
                              rows="4"
                              class="w-full rounded-2xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#00ff95]"
                              placeholder="Ví dụ: Nhóm món để dành cho cuối tuần..."></textarea>
                    <span asp-validation-for="Reason" class="text-red-600 text-sm"></span>
                </div>

                <div class="rounded-2xl border border-cyan-200 bg-cyan-50 px-4 py-3 text-sm text-cyan-800">
                    Sau khi xác nhận, các món này sẽ rời khỏi danh sách chính và xuất hiện trong đúng vùng lưu trữ bạn chọn.
                </div>

                <div class="flex flex-col gap-3 pt-2">
                    <button type="submit"
                            class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-5 py-3 font-medium text-white hover:bg-slate-800 transition">
                        <span class="material-symbols-outlined mr-2 text-[18px]">archive</span>
                        Lưu trữ tất cả món đã chọn
                    </button>

                    <a asp-action="Index"
                       class="inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white px-5 py-3 font-medium text-slate-700 hover:bg-slate-50 transition">
                        Quay lại danh sách
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const createNewCheckbox = document.getElementById('CreateNewArchiveGroup');
            const newGroupWrapper = document.getElementById('NewArchiveGroupNameWrapper');
            const archiveGroupSelect = document.getElementById('ArchiveGroupId');

            function syncArchiveGroupMode() {
                const isCreatingNew = createNewCheckbox && createNewCheckbox.checked;

                if (newGroupWrapper) {
                    newGroupWrapper.classList.toggle('hidden', !isCreatingNew);
                }

                if (archiveGroupSelect) {
                    archiveGroupSelect.disabled = isCreatingNew;
                }
            }

            if (createNewCheckbox) {
                createNewCheckbox.addEventListener('change', syncArchiveGroupMode);
            }

            syncArchiveGroupMode();
        })();
    </script>
}
