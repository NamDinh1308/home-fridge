@model HomeFridgev1.Models.ViewModels.FoodIndexViewModel

@{
    ViewData["Title"] = "Danh sách thực phẩm";
}

<div class="max-w-[1075px] mx-auto px-4 md:px-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
        <div>
            <h1 class="text-2xl font-bold text-slate-800 font-headline">Danh sách thực phẩm</h1>
            <p class="mt-2 text-slate-600 text-sm">Các món hiện có trong kho gia đình.</p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
            <a asp-action="History"
               class="inline-flex items-center justify-center rounded-[1.25rem] border border-slate-200 bg-white px-6 py-2.5 font-bold text-slate-700 hover:bg-slate-50 transition-all shadow-sm">
                <span class="material-symbols-outlined mr-2 text-xl">history</span> Lịch sử
            </a>

            <a asp-action="Archived"
               class="inline-flex items-center justify-center rounded-[1.25rem] border border-slate-200 bg-white px-6 py-2.5 font-bold text-slate-700 hover:bg-slate-50 transition-all shadow-sm">
                <span class="material-symbols-outlined mr-2 text-xl">inventory_2</span> Kho lưu trữ
            </a>

            <a asp-action="Create"
               class="inline-flex items-center justify-center rounded-[1.25rem] bg-primary hover:bg-emerald-600 text-white px-6 py-2.5 font-bold transition-all shadow-[0_10px_20px_-10px_rgba(16,185,129,0.5)] hover:-translate-y-0.5">
                <span class="material-symbols-outlined mr-2 text-xl">add</span> Thêm thực phẩm
            </a>
        </div>
    </div>

    <form method="get" asp-action="Index"
          class="mb-6 bg-surface-container-lowest rounded-[2rem] border border-slate-100 shadow-sm p-5">
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-4">
            <div class="xl:col-span-2">
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">
                    Tìm kiếm
                </label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-[20px]">
                        search
                    </span>
                    <input type="text"
                           name="searchTerm"
                           value="@Model.SearchTerm"
                           placeholder="Tìm theo tên thực phẩm..."
                           class="w-full rounded-[1.25rem] border border-slate-200 bg-white pl-12 pr-4 py-3 text-sm text-slate-700 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-200 focus:border-emerald-300 transition-all" />
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">
                    Danh mục
                </label>
                <select name="categoryId"
                        class="w-full rounded-[1.25rem] border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-200 focus:border-emerald-300 transition-all">
                    @foreach (var item in Model.Categories)
                    {
                        if (Model.CategoryId.HasValue && item.Value == Model.CategoryId.Value.ToString())
                        {
                            <option value="@item.Value" selected>@item.Text</option>
                        }
                        else if (!Model.CategoryId.HasValue && string.IsNullOrEmpty(item.Value))
                        {
                            <option value="@item.Value" selected>@item.Text</option>
                        }
                        else
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">
                    Vị trí
                </label>
                <select name="storageLocationId"
                        class="w-full rounded-[1.25rem] border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-200 focus:border-emerald-300 transition-all">
                    @foreach (var item in Model.StorageLocations)
                    {
                        if (Model.StorageLocationId.HasValue && item.Value == Model.StorageLocationId.Value.ToString())
                        {
                            <option value="@item.Value" selected>@item.Text</option>
                        }
                        else if (!Model.StorageLocationId.HasValue && string.IsNullOrEmpty(item.Value))
                        {
                            <option value="@item.Value" selected>@item.Text</option>
                        }
                        else
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">
                    Trạng thái
                </label>
                <select name="status"
                        class="w-full rounded-[1.25rem] border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-200 focus:border-emerald-300 transition-all">
                    @foreach (var item in Model.Statuses)
                    {
                        if (Model.Status == item.Value)
                        {
                            <option value="@item.Value" selected>@item.Text</option>
                        }
                        else
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_auto] gap-4 mt-4 items-end">
            <div class="md:max-w-xs">
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">
                    Sắp xếp
                </label>
                <select name="sortBy"
                        class="w-full rounded-[1.25rem] border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-200 focus:border-emerald-300 transition-all">
                    @foreach (var item in Model.SortOptions)
                    {
                        if ((string.IsNullOrEmpty(Model.SortBy) && string.IsNullOrEmpty(item.Value)) || Model.SortBy == item.Value)
                        {
                            <option value="@item.Value" selected>@item.Text</option>
                        }
                        else
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
            </div>

            <button type="submit"
                    class="inline-flex items-center justify-center rounded-[1.25rem] bg-slate-900 hover:bg-slate-800 text-white px-5 py-3 font-bold text-sm transition-all shadow-sm hover:-translate-y-0.5">
                <span class="material-symbols-outlined mr-2 text-[18px]">filter_alt</span>
                Lọc dữ liệu
            </button>

            <a asp-action="Index"
               class="inline-flex items-center justify-center rounded-[1.25rem] border border-slate-200 bg-white px-5 py-3 font-bold text-sm text-slate-600 hover:bg-slate-50 transition-all shadow-sm">
                <span class="material-symbols-outlined mr-2 text-[18px]">restart_alt</span>
                Xóa bộ lọc
            </a>
        </div>
    </form>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 rounded-[1.25rem] border border-green-200 bg-green-50 px-5 py-4 text-green-700 text-sm font-medium shadow-sm">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 rounded-[1.25rem] border border-red-200 bg-red-50 px-5 py-4 text-red-700 text-sm font-medium shadow-sm">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Items.Any())
    {
        <div class="bg-surface-container-lowest rounded-[2rem] border border-slate-100 shadow-sm p-12 text-center">
            <div class="w-16 h-16 mx-auto bg-surface-container-low rounded-full flex items-center justify-center mb-4">
                <span class="material-symbols-outlined text-3xl text-slate-400">kitchen</span>
            </div>
            <h2 class="text-lg font-semibold text-slate-700 font-headline">Không tìm thấy thực phẩm phù hợp</h2>
            <p class="mt-2 text-slate-500 text-sm">
                Hãy thử thay đổi từ khóa tìm kiếm hoặc bộ lọc, hoặc thêm món mới vào kho.
            </p>

            <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-3">
                <a asp-action="Create"
                   class="inline-flex items-center justify-center rounded-[1.25rem] bg-primary hover:bg-emerald-600 text-white px-6 py-2.5 font-bold transition-all shadow-[0_10px_20px_-10px_rgba(16,185,129,0.5)] hover:-translate-y-0.5">
                    Thêm thực phẩm ngay
                </a>

                <a asp-action="Index"
                   class="inline-flex items-center justify-center rounded-[1.25rem] border border-slate-200 bg-white px-6 py-2.5 font-bold text-slate-600 hover:bg-slate-50 transition-all shadow-sm">
                    Xóa bộ lọc
                </a>
            </div>
        </div>
    }
    else
    {
        <div id="bulkArchiveBar"
             class="hidden mb-6 rounded-[1.5rem] border border-slate-200 bg-white px-5 py-4 shadow-sm">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                <div class="text-sm text-slate-700">
                    Đã chọn <strong id="selectedFoodCount">0</strong> món
                </div>

                <div class="flex flex-wrap gap-3">
                    <button type="button"
                            id="bulkArchiveButton"
                            class="inline-flex items-center justify-center rounded-[1.25rem] bg-slate-900 px-5 py-2.5 font-bold text-white hover:bg-slate-800 transition-all shadow-sm">
                        <span class="material-symbols-outlined mr-2 text-[18px]">archive</span>
                        Lưu trữ đã chọn
                    </button>

                    <button type="button"
                            id="clearFoodSelectionButton"
                            class="inline-flex items-center justify-center rounded-[1.25rem] border border-slate-200 bg-white px-5 py-2.5 font-bold text-slate-700 hover:bg-slate-50 transition-all shadow-sm">
                        Bỏ chọn
                    </button>
                </div>
            </div>
        </div>

        <form id="bulkArchiveSubmitForm" method="get" asp-action="ArchiveSelected"></form>

        <div class="hidden md:block bg-surface-container-lowest rounded-[2rem] border border-slate-100 shadow-sm overflow-hidden transition-all hover:shadow-md">
            <div class="overflow-x-auto">
                <table class="min-w-full">
                    <thead class="bg-slate-50/50">
                        <tr class="text-left text-xs font-bold text-slate-500 uppercase tracking-wider">
                            <th class="px-6 py-4 w-[56px]">
                                <input type="checkbox"
                                       id="selectAllFoods"
                                       class="h-4 w-4 rounded border-slate-300 text-emerald-500 focus:ring-emerald-400" />
                            </th>
                            <th class="px-6 py-4">Tên thực phẩm</th>
                            <th class="px-6 py-4">Danh mục</th>
                            <th class="px-6 py-4">Vị trí</th>
                            <th class="px-6 py-4">Số lượng</th>
                            <th class="px-6 py-4">Hạn dùng</th>
                            <th class="px-6 py-4">Trạng thái</th>
                            <th class="px-6 py-4 text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var item in Model.Items)
                        {
                            var menuId = $"action-menu-{item.Id}";
                            var isOutOfStock = item.CurrentStatus == HomeFridgev1.Models.Enums.FoodStatus.OutOfStock;
                            var isExpired = item.CurrentStatus == HomeFridgev1.Models.Enums.FoodStatus.Expired;

                            var canConsume = !isOutOfStock && !isExpired;
                            var canRestock = !isExpired;
                            var canDiscard = !isOutOfStock;

                            var blockedMessage = isOutOfStock
                                ? "Món đã hết hàng: chỉ có thể bổ sung thêm hoặc chỉnh sửa thông tin."
                                : isExpired
                                    ? "Món đã hết hạn: chỉ có thể thực hiện thao tác bỏ đi."
                                    : null;

                            <tr class="text-sm text-slate-700 hover:bg-slate-50/50 transition-colors">
                                <td class="px-6 py-4 align-top">
                                    <input type="checkbox"
                                           class="food-select-checkbox h-4 w-4 rounded border-slate-300 text-emerald-500 focus:ring-emerald-400"
                                           value="@item.Id" />
                                </td>

                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                                        {
                                            <div class="h-14 w-14 rounded-2xl overflow-hidden border border-slate-200 bg-slate-50 shrink-0">
                                                <img src="@item.ImagePath"
                                                     alt="@item.Name"
                                                     class="h-full w-full object-cover" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="h-14 w-14 rounded-2xl border border-dashed border-slate-300 bg-slate-50 flex items-center justify-center text-slate-400 shrink-0">
                                                <span class="material-symbols-outlined text-[20px]">image</span>
                                            </div>
                                        }

                                        <div class="min-w-0">
                                            <div class="font-bold text-slate-800">@item.Name</div>
                                            @if (string.IsNullOrWhiteSpace(item.ImagePath))
                                            {
                                                <div class="text-xs text-slate-400 mt-0.5">Chưa có ảnh</div>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td class="px-6 py-4">@item.Category?.Name</td>
                                <td class="px-6 py-4 text-slate-500">@item.StorageLocation?.Name</td>
                                <td class="px-6 py-4 font-semibold">
                                    @(item.CurrentQuantity.ToString("0.##")) <span class="text-slate-400 text-xs ml-1">@item.Unit</span>
                                </td>
                                <td class="px-6 py-4">@item.ExpiryDate.ToString("dd/MM/yyyy")</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center rounded-full px-3 py-1 text-[11px] font-bold uppercase tracking-wider
                                        @(item.CurrentStatus.ToString() == "Normal" ? "bg-emerald-50 text-emerald-700 border border-emerald-200" :
                                          item.CurrentStatus.ToString() == "Warning" ? "bg-amber-50 text-amber-700 border border-amber-200" :
                                          item.CurrentStatus.ToString() == "Urgent" ? "bg-orange-50 text-orange-700 border border-orange-200" :
                                          item.CurrentStatus.ToString() == "Expired" ? "bg-red-50 text-red-700 border border-red-200" :
                                          item.CurrentStatus.ToString() == "OutOfStock" ? "bg-slate-100 text-slate-600 border border-slate-200" :
                                          "bg-slate-100 text-slate-600 border border-slate-200")">
                                        @item.CurrentStatus
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="relative inline-flex items-center gap-2">
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-bold text-slate-600 hover:bg-emerald-50 hover:text-emerald-700 hover:border-emerald-200 transition-all shadow-sm">
                                            <span class="material-symbols-outlined text-[16px] mr-1">edit</span> Sửa
                                        </a>

                                        <button type="button"
                                                class="action-menu-button inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-2.5 py-1.5 text-slate-500 hover:bg-slate-50 hover:text-slate-700 transition-all"
                                                data-menu-id="@menuId"
                                                aria-expanded="false"
                                                aria-haspopup="true">
                                            <span class="material-symbols-outlined text-[18px]">more_vert</span>
                                        </button>

                                        <div id="@menuId"
                                             class="action-menu hidden absolute right-0 top-full mt-2 w-64 rounded-2xl border border-slate-200 bg-white shadow-lg z-20 overflow-hidden">

                                            @if (canConsume)
                                            {
                                                <a asp-action="Consume"
                                                   asp-route-id="@item.Id"
                                                   class="flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">
                                                    <span class="material-symbols-outlined text-[18px] text-amber-600">remove_circle</span>
                                                    Dùng bớt
                                                </a>
                                            }
                                            else
                                            {
                                                <div class="flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-400 bg-slate-50 cursor-not-allowed">
                                                    <span class="material-symbols-outlined text-[18px] text-slate-400">remove_circle</span>
                                                    Dùng bớt
                                                </div>
                                            }

                                            @if (canRestock)
                                            {
                                                <a asp-action="Restock"
                                                   asp-route-id="@item.Id"
                                                   class="flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">
                                                    <span class="material-symbols-outlined text-[18px] text-emerald-600">add_circle</span>
                                                    Bổ sung
                                                </a>
                                            }
                                            else
                                            {
                                                <div class="flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-400 bg-slate-50 cursor-not-allowed">
                                                    <span class="material-symbols-outlined text-[18px] text-slate-400">add_circle</span>
                                                    Bổ sung
                                                </div>
                                            }

                                            @if (canDiscard)
                                            {
                                                <a asp-action="Discard"
                                                   asp-route-id="@item.Id"
                                                   class="flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">
                                                    <span class="material-symbols-outlined text-[18px] text-red-600">delete</span>
                                                    Bỏ đi
                                                </a>
                                            }
                                            else
                                            {
                                                <div class="flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-400 bg-slate-50 cursor-not-allowed">
                                                    <span class="material-symbols-outlined text-[18px] text-slate-400">delete</span>
                                                    Bỏ đi
                                                </div>
                                            }

                                            <a asp-action="ArchiveSelected"
                                               asp-route-selectedIds="@item.Id"
                                               class="flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors border-t border-slate-100">
                                                <span class="material-symbols-outlined text-[18px] text-slate-600">archive</span>
                                                Lưu trữ
                                            </a>

                                            @if (!string.IsNullOrWhiteSpace(blockedMessage))
                                            {
                                                <div class="border-t border-slate-100 px-4 py-3 text-xs leading-relaxed text-slate-500 bg-slate-50">
                                                    @blockedMessage
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="md:hidden flex items-center justify-between mb-4 px-2">
            <label class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 cursor-pointer">
                <input type="checkbox" id="selectAllFoodsMobile" class="h-4 w-4 rounded border-slate-300 text-emerald-500 focus:ring-emerald-400" />
                Chọn tất cả thực phẩm
            </label>
        </div>

        <div class="md:hidden space-y-4 mb-6">
            @foreach (var item in Model.Items)
            {
                var menuIdMobile = $"action-menu-mobile-{item.Id}";
                var isOutOfStock = item.CurrentStatus == HomeFridgev1.Models.Enums.FoodStatus.OutOfStock;
                var isExpired = item.CurrentStatus == HomeFridgev1.Models.Enums.FoodStatus.Expired;

                var canConsume = !isOutOfStock && !isExpired;
                var canRestock = !isExpired;
                var canDiscard = !isOutOfStock;

                var blockedMessage = isOutOfStock
                    ? "Món đã hết hàng: chỉ có thể bổ sung thêm hoặc chỉnh sửa thông tin."
                    : isExpired
                        ? "Món đã hết hạn: chỉ có thể thực hiện thao tác bỏ đi."
                        : null;

                <div class="bg-surface-container-lowest rounded-[2rem] border border-slate-100 shadow-sm p-4 relative flex flex-col gap-3">
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex items-center gap-3">
                            <input type="checkbox"
                                   class="food-select-checkbox h-4 w-4 rounded border-slate-300 text-emerald-500 focus:ring-emerald-400 shrink-0"
                                   value="@item.Id" />
                            
                            @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                            {
                                <div class="h-12 w-12 rounded-2xl overflow-hidden border border-slate-200 bg-slate-50 shrink-0">
                                    <img src="@item.ImagePath"
                                         alt="@item.Name"
                                         class="h-full w-full object-cover" />
                                </div>
                            }
                            else
                            {
                                <div class="h-12 w-12 rounded-2xl border border-dashed border-slate-300 bg-slate-50 flex items-center justify-center text-slate-400 shrink-0">
                                    <span class="material-symbols-outlined text-[18px]">image</span>
                                </div>
                            }

                            <div class="min-w-0">
                                <div class="font-bold text-slate-800 text-base leading-tight">@item.Name</div>
                                @if (string.IsNullOrWhiteSpace(item.ImagePath))
                                {
                                    <div class="text-[11px] text-slate-400 mt-0.5">Chưa có ảnh</div>
                                }
                            </div>
                        </div>

                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider shrink-0
                            @(item.CurrentStatus.ToString() == "Normal" ? "bg-emerald-50 text-emerald-700 border border-emerald-200" :
                              item.CurrentStatus.ToString() == "Warning" ? "bg-amber-50 text-amber-700 border border-amber-200" :
                              item.CurrentStatus.ToString() == "Urgent" ? "bg-orange-50 text-orange-700 border border-orange-200" :
                              item.CurrentStatus.ToString() == "Expired" ? "bg-red-50 text-red-700 border border-red-200" :
                              item.CurrentStatus.ToString() == "OutOfStock" ? "bg-slate-100 text-slate-600 border border-slate-200" :
                              "bg-slate-100 text-slate-600 border border-slate-200")">
                            @item.CurrentStatus
                        </span>
                    </div>

                    <div class="grid grid-cols-2 gap-2 text-xs py-2 border-y border-slate-50">
                        <div>
                            <span class="text-slate-400 block mb-0.5">Danh mục</span>
                            <span class="font-medium text-slate-700 bg-slate-50 px-2 py-0.5 rounded-md inline-block">@item.Category?.Name</span>
                        </div>
                        <div>
                            <span class="text-slate-400 block mb-0.5">Vị trí</span>
                            <span class="font-medium text-slate-700 bg-slate-50 px-2 py-0.5 rounded-md inline-block">@item.StorageLocation?.Name</span>
                        </div>
                        <div>
                            <span class="text-slate-400 block mb-0.5">Số lượng</span>
                            <span class="font-bold text-slate-800 text-sm">
                                @(item.CurrentQuantity.ToString("0.##")) <span class="text-slate-400 text-xs font-normal">@item.Unit</span>
                            </span>
                        </div>
                        <div>
                            <span class="text-slate-400 block mb-0.5">Hạn dùng</span>
                            <span class="font-semibold text-slate-700">@item.ExpiryDate.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>

                    <div class="flex items-center justify-between mt-1">
                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-600 hover:bg-emerald-50 hover:text-emerald-700 hover:border-emerald-200 transition-all shadow-sm">
                            <span class="material-symbols-outlined text-[16px] mr-1">edit</span> Sửa
                        </a>

                        <div class="relative">
                            <button type="button"
                                    class="action-menu-button inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-500 hover:bg-slate-50 hover:text-slate-700 transition-all shadow-sm"
                                    data-menu-id="@menuIdMobile"
                                    aria-expanded="false"
                                    aria-haspopup="true">
                                <span class="material-symbols-outlined text-[16px] mr-1">more_horiz</span> Tùy chọn
                            </button>

                            <div id="@menuIdMobile"
                                 class="action-menu hidden absolute right-0 top-full mt-2 w-56 rounded-2xl border border-slate-200 bg-white shadow-lg z-30 overflow-hidden">

                                @if (canConsume)
                                {
                                    <a asp-action="Consume"
                                       asp-route-id="@item.Id"
                                       class="flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">
                                        <span class="material-symbols-outlined text-[18px] text-amber-600">remove_circle</span>
                                        Dùng bớt
                                    </a>
                                }
                                else
                                {
                                    <div class="flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-400 bg-slate-50 cursor-not-allowed">
                                        <span class="material-symbols-outlined text-[18px] text-slate-400">remove_circle</span>
                                        Dùng bớt
                                    </div>
                                }

                                @if (canRestock)
                                {
                                    <a asp-action="Restock"
                                       asp-route-id="@item.Id"
                                       class="flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">
                                        <span class="material-symbols-outlined text-[18px] text-emerald-600">add_circle</span>
                                        Bổ sung
                                    </a>
                                }
                                else
                                {
                                    <div class="flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-400 bg-slate-50 cursor-not-allowed">
                                        <span class="material-symbols-outlined text-[18px] text-slate-400">add_circle</span>
                                        Bổ sung
                                    </div>
                                }

                                @if (canDiscard)
                                {
                                    <a asp-action="Discard"
                                       asp-route-id="@item.Id"
                                       class="flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">
                                        <span class="material-symbols-outlined text-[18px] text-red-600">delete</span>
                                        Bỏ đi
                                    </a>
                                }
                                else
                                {
                                    <div class="flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-400 bg-slate-50 cursor-not-allowed">
                                        <span class="material-symbols-outlined text-[18px] text-slate-400">delete</span>
                                        Bỏ đi
                                    </div>
                                }

                                <a asp-action="ArchiveSelected"
                                   asp-route-selectedIds="@item.Id"
                                   class="flex items-center gap-3 px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors border-t border-slate-100">
                                    <span class="material-symbols-outlined text-[18px] text-slate-600">archive</span>
                                    Lưu trữ
                                </a>

                                @if (!string.IsNullOrWhiteSpace(blockedMessage))
                                {
                                    <div class="border-t border-slate-100 px-4 py-3 text-xs leading-relaxed text-slate-500 bg-slate-50">
                                        @blockedMessage
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const buttons = document.querySelectorAll('.action-menu-button');
            const menus = document.querySelectorAll('.action-menu');

            function closeAllMenus() {
                menus.forEach(menu => menu.classList.add('hidden'));
                buttons.forEach(btn => btn.setAttribute('aria-expanded', 'false'));
            }

            buttons.forEach(button => {
                button.addEventListener('click', function (event) {
                    event.stopPropagation();

                    const menuId = this.dataset.menuId;
                    const targetMenu = document.getElementById(menuId);
                    if (!targetMenu) return;
                    const isHidden = targetMenu.classList.contains('hidden');

                    closeAllMenus();

                    if (isHidden) {
                        targetMenu.classList.remove('hidden');
                        this.setAttribute('aria-expanded', 'true');
                    }
                });
            });

            document.addEventListener('click', function () {
                closeAllMenus();
            });

            menus.forEach(menu => {
                menu.addEventListener('click', function (event) {
                    event.stopPropagation();
                });
            });
        })();

        (function () {
            const selectAllCheckbox = document.getElementById('selectAllFoods');
            const selectAllCheckboxMobile = document.getElementById('selectAllFoodsMobile');
            const itemCheckboxes = Array.from(document.querySelectorAll('.food-select-checkbox'));
            const bulkArchiveBar = document.getElementById('bulkArchiveBar');
            const selectedFoodCount = document.getElementById('selectedFoodCount');
            const bulkArchiveButton = document.getElementById('bulkArchiveButton');
            const clearFoodSelectionButton = document.getElementById('clearFoodSelectionButton');
            const bulkArchiveSubmitForm = document.getElementById('bulkArchiveSubmitForm');

            if (!bulkArchiveBar || !selectedFoodCount || !bulkArchiveButton || !clearFoodSelectionButton || !bulkArchiveSubmitForm) {
                return;
            }

            function getSelectedIds() {
                return itemCheckboxes
                    .filter(x => x.checked)
                    .map(x => x.value);
            }

            function refreshSelectionUI() {
                const selectedIds = getSelectedIds();
                const uniqueSelectedIds = [...new Set(selectedIds)];
                const count = uniqueSelectedIds.length;

                selectedFoodCount.textContent = count.toString();

                if (count > 0) {
                    bulkArchiveBar.classList.remove('hidden');
                } else {
                    bulkArchiveBar.classList.add('hidden');
                }

                const distinctIds = [...new Set(itemCheckboxes.map(x => x.value))];
                const allChecked = distinctIds.length > 0 && distinctIds.every(id => {
                    return itemCheckboxes.some(x => x.value === id && x.checked);
                });

                if (selectAllCheckbox) {
                    selectAllCheckbox.checked = allChecked;
                }
                if (selectAllCheckboxMobile) {
                    selectAllCheckboxMobile.checked = allChecked;
                }
            }

            function handleSelectAll(checked) {
                itemCheckboxes.forEach(x => {
                    x.checked = checked;
                });
                if (selectAllCheckbox) {
                    selectAllCheckbox.checked = checked;
                }
                if (selectAllCheckboxMobile) {
                    selectAllCheckboxMobile.checked = checked;
                }
                refreshSelectionUI();
            }

            if (selectAllCheckbox) {
                selectAllCheckbox.addEventListener('change', function () {
                    handleSelectAll(this.checked);
                });
            }

            if (selectAllCheckboxMobile) {
                selectAllCheckboxMobile.addEventListener('change', function () {
                    handleSelectAll(this.checked);
                });
            }

            itemCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function () {
                    const val = this.value;
                    itemCheckboxes.forEach(other => {
                        if (other !== this && other.value === val) {
                            other.checked = this.checked;
                        }
                    });
                    refreshSelectionUI();
                });
            });

            clearFoodSelectionButton.addEventListener('click', function () {
                itemCheckboxes.forEach(x => x.checked = false);
                if (selectAllCheckbox) {
                    selectAllCheckbox.checked = false;
                }
                if (selectAllCheckboxMobile) {
                    selectAllCheckboxMobile.checked = false;
                }
                refreshSelectionUI();
            });

            bulkArchiveButton.addEventListener('click', function () {
                const selectedIds = getSelectedIds();
                const uniqueSelectedIds = [...new Set(selectedIds)];

                if (uniqueSelectedIds.length === 0) {
                    return;
                }

                bulkArchiveSubmitForm.innerHTML = '';

                uniqueSelectedIds.forEach(id => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'selectedIds';
                    input.value = id;
                    bulkArchiveSubmitForm.appendChild(input);
                });

                bulkArchiveSubmitForm.submit();
            });

            refreshSelectionUI();
        })();
    </script>
}
