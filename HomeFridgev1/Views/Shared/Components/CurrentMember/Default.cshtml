@model HomeFridgev1.Models.ViewModels.CurrentMemberInfoViewModel

@if (Model.Id > 0)
{
    <div class="flex items-center justify-between px-6 py-2.5 bg-white/60 backdrop-blur-xl border-b border-slate-100 text-sm">
        <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-full bg-primary/10 flex items-center justify-center">
                <span class="material-symbols-outlined text-primary text-[16px]" style="font-variation-settings: 'FILL' 1;">person</span>
            </div>
            <span class="text-slate-400 font-medium">Thành viên:</span>
            <span class="font-bold text-slate-800">@Model.DisplayName</span>
            <span class="text-[11px] font-semibold text-slate-400 bg-slate-100 rounded-full px-2 py-0.5">@Model.Role</span>
        </div>
        <a asp-controller="Members"
           asp-action="Select"
           asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
           class="inline-flex items-center gap-1 text-xs font-semibold text-primary hover:text-emerald-700 transition-colors">
            <span class="material-symbols-outlined text-[14px]">swap_horiz</span>
            Đổi thành viên
        </a>
    </div>
}
else
{
    <div class="flex items-center justify-center px-6 py-2.5 bg-amber-50/80 backdrop-blur-xl border-b border-amber-100 text-sm">
        <a asp-controller="Members"
           asp-action="Select"
           asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
           class="inline-flex items-center gap-2 text-xs font-semibold text-amber-700 hover:text-amber-900 transition-colors">
            <span class="material-symbols-outlined text-[16px]">warning</span>
            Chưa chọn thành viên — Bấm để chọn
        </a>
    </div>
}